# ── Database: Google Sheets (falls back to a local Excel workbook) ────────
# Google Sheets is used automatically when GOOGLE_SERVICE_ACCOUNT_KEY and
# GOOGLE_SHEETS_ID are both set and reachable. Otherwise the app creates
# and uses a local popms_database.xlsx file with zero configuration.

# Full contents of a Google Cloud service account JSON key, as one line.
# Create one at: Google Cloud Console -> IAM & Admin -> Service Accounts -> Keys.
# Used for both Google Sheets and Google Drive access.
GOOGLE_SERVICE_ACCOUNT_KEY=

# Alternative to GOOGLE_SERVICE_ACCOUNT_KEY: path to the downloaded JSON key file.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=

# Spreadsheet ID, from the sheet URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
# Share the spreadsheet with the service account's client_email as an Editor.
GOOGLE_SHEETS_ID=

# Force local Excel mode even if Google Sheets credentials are present
USE_LOCAL_EXCEL=false

# ── File storage: Google Drive (falls back to local disk) ─────────────────
# Google Drive is used automatically when GOOGLE_SERVICE_ACCOUNT_KEY and
# GOOGLE_DRIVE_FOLDER_ID are both set and reachable. Otherwise uploaded
# files are stored locally in the uploads/ folder.

# Drive folder ID, from the folder URL: https://drive.google.com/drive/folders/<THIS_PART>
# Share the folder with the service account's client_email as an Editor.
GOOGLE_DRIVE_FOLDER_ID=

# ── Google Sign-In (optional) ──────────────────────────────────────────────
# When set, adds a "Sign in with Google" button to the login screen.
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console
# and add your app's URL to Authorized JavaScript origins.
# The frontend reads this from GET /api/status, no Vite-side env var needed.
GOOGLE_OAUTH_CLIENT_ID=

# ── Sessions ────────────────────────────────────────────────────────────
# Secret used to sign login sessions. Set a long random string in production
# (e.g. `openssl rand -hex 32`) — if unset, a temporary secret is generated
# at startup and all sessions are invalidated on restart.
SESSION_SECRET=
