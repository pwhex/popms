{
  "name": "popms",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n \"backend,frontend\" -c \"yellow,blue\" \"nodemon --watch server.js server.js\" \"vite\"",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "electron:start": "vite build && electron .",
    "electron:build": "vite build && electron-builder"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "google-auth-library": "^11.0.0",
    "googleapis": "^174.0.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.395.0",
    "multer": "^1.4.5-lts.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "nodemon": "^3.1.3",
    "vite": "^5.2.11"
  },
  "build": {
    "appId": "com.kingshospital.popms",
    "productName": "POPMS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "server.js",
      "electron/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
